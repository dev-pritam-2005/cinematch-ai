# Copy to .env (git-ignored). All values are optional.
# TMDB API key or v4 read-access token, used ONLY to load posters:
TMDB_API_KEY=
# Folder containing tmdb_5000_movies.csv and tmdb_5000_credits.csv (default: ./data)
CINEMATCH_DATA_DIR=
# Location of the local SQLite file for watchlist/favorites (default: ./data/cinematch.db)
CINEMATCH_DB_PATH=
